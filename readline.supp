{
   ignore_libreadline_memory_errors
   Memcheck:Leak
   ...
   obj:*/libreadline.so.*
}
{
   ignore_ls_memory_errors
   Memcheck:Leak
   ...
   obj:*/bin/ls
}
{
   ignore_grep_memory_errors
   Memcheck:Leak
   ...
   obj:*/bin/grep
}
{
   ignore_child_processes
   Memcheck:Leak
   ...
   fun:(below main)
}
